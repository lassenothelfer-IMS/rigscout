# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: model and effort for the research agent.
# Defaults: claude-opus-5 at "high". Lower effort = fewer tokens and a cheaper, faster, shallower search.
# RIGSCOUT_MODEL=claude-opus-5
# RIGSCOUT_EFFORT=high

# Optional: require this code before anyone can start a (paid) search. Set it if you deploy RigScout publicly.
# RIGSCOUT_ACCESS_CODE=
