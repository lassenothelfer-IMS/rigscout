# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: model and effort for the research agent.
# Supported models: claude-opus-5 (default), claude-opus-5-5, claude-sonnet-5, claude-fable-5-1.
# Default effort is "high". Lower effort = fewer tokens and a cheaper, faster, shallower search.
# RIGSCOUT_MODEL=claude-opus-5
# RIGSCOUT_EFFORT=high

# Optional spend guards for one search run (defaults shown). At the limit the agent is told to wrap up;
# at 1.5x the run is stopped.
# RIGSCOUT_MAX_COST_USD=6
# RIGSCOUT_MAX_SEARCHES=60
# RIGSCOUT_MAX_CONCURRENT=2
